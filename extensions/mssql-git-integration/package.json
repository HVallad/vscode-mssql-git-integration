{
    "name": "mssql-git-integration",
    "displayName": "MSSQL Git Integration",
    "description": "Git integration and source control for SQL Server databases",
    "version": "0.1.0",
    "publisher": "hvallad",
    "preview": true,
    "homepage": "https://github.com/HVallad/vscode-mssql-git-integration",
    "engines": {
        "vscode": "^1.98.0"
    },
    "license": "MIT",
    "icon": "images/icon.png",
    "activationEvents": [
        "onView:objectExplorer"
    ],
    "main": "./out/src/extension.js",
    "l10n": "./l10n",
    "repository": {
        "type": "git",
        "url": "https://github.com/HVallad/vscode-mssql-git-integration.git"
    },
    "extensionDependencies": [
        "ms-mssql.mssql"
    ],
    "scripts": {
        "build:extension": "tsc -p tsconfig.extension.json",
        "build": "yarn build:extension",
        "watch": "tsc -watch -p tsconfig.extension.json --preserveWatchOutput",
        "lint": "eslint ./src",
        "test": "yarn build && node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/glob": "^9.0.0",
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.98.0",
        "typescript": "^5.0.0"
    },
    "dependencies": {
        "fast-glob": "^3.3.3",
        "simple-git": "^3.22.0"
    },
    "contributes": {
        "commands": [
            {
                "command": "mssql-git.linkDatabaseToGitBranch",
                "title": "Link Database to Git Branch",
                "category": "MSSQL Git"
            },
            {
                "command": "mssql-git.unlinkDatabaseFromGitBranch",
                "title": "Unlink Database from Git Branch",
                "category": "MSSQL Git"
            },
            {
                "command": "mssql-git.compareDatabaseToRepo",
                "title": "Compare Database to Repo (Fast)",
                "category": "MSSQL Git"
            },
            {
                "command": "mssql-git.deepCompareDatabaseToRepo",
                "title": "Deep Compare Database to Repo",
                "category": "MSSQL Git"
            },
            {
                "command": "mssql-git.reinitializeSyncMetadata",
                "title": "Reinitialize Sync Metadata",
                "category": "MSSQL Git"
            },
            {
                "command": "mssql-git.refreshLocalCache",
                "title": "Refresh Local Cache",
                "category": "MSSQL Git"
            },
            {
                "command": "mssql-git.compareDatabaseAndLaunchSchemaCompare",
                "title": "Compare and Open in Schema Compare",
                "category": "MSSQL Git"
            }
        ],
        "menus": {
            "view/item/context": [
                {
                    "command": "mssql-git.linkDatabaseToGitBranch",
                    "when": "view == objectExplorer && viewItem =~ /type=Database/ && viewItem =~ /gitLinked=false/",
                    "group": "8_MSSQL_gitIntegration@1"
                },
                {
                    "command": "mssql-git.unlinkDatabaseFromGitBranch",
                    "when": "view == objectExplorer && viewItem =~ /type=Database/ && viewItem =~ /gitLinked=true/",
                    "group": "8_MSSQL_gitIntegration@2"
                },
                {
                    "command": "mssql-git.compareDatabaseToRepo",
                    "when": "view == objectExplorer && viewItem =~ /type=Database/ && viewItem =~ /gitLinked=true/",
                    "group": "8_MSSQL_gitIntegration@3"
                },
                {
                    "command": "mssql-git.deepCompareDatabaseToRepo",
                    "when": "view == objectExplorer && viewItem =~ /type=Database/ && viewItem =~ /gitLinked=true/",
                    "group": "8_MSSQL_gitIntegration@4"
                },
                {
                    "command": "mssql-git.reinitializeSyncMetadata",
                    "when": "view == objectExplorer && viewItem =~ /type=Database/ && viewItem =~ /gitLinked=true/",
                    "group": "8_MSSQL_gitIntegration@5"
                },
                {
                    "command": "mssql-git.compareDatabaseAndLaunchSchemaCompare",
                    "when": "view == objectExplorer && viewItem =~ /type=Database/ && viewItem =~ /gitLinked=true/",
                    "group": "8_MSSQL_gitIntegration@6"
                },
                {
                    "command": "mssql-git.refreshLocalCache",
                    "when": "view == objectExplorer && viewItem =~ /type=Database/",
                    "group": "9_MSSQL_localCache@1"
                }
            ]
        },
        "configuration": {
            "type": "object",
            "title": "MSSQL Git Integration",
            "properties": {
                "mssqlGitIntegration.schemaCompare.excludePermissions": {
                    "type": "boolean",
                    "default": true,
                    "description": "Exclude permission statements when comparing database schemas. When enabled, GRANT, DENY, and REVOKE statements are ignored during comparison."
                },
                "mssqlGitIntegration.schemaCompare.excludeWhitespace": {
                    "type": "boolean",
                    "default": false,
                    "description": "Ignore whitespace differences when comparing database schemas. When enabled, differences in formatting and spacing are ignored."
                }
            }
        }
    }
}
